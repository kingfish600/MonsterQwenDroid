+// ---------------------------------------------------------------------------
+// Expert-slice prefetch for mmap'd MoE weights (BONSAI_MOE_PREFETCH).
+//
+// Expert weights live in a memory-mapped file, and a demand fault reads on the
+// order of a page. A token that routes through ~663 MB of expert slices can
+// therefore pay tens of thousands of small reads. Issuing WILLNEED for a whole
+// slice (460 KB here) turns that into one large read, and issuing it from the
+// *previous* matmul of the same layer hides the latency behind compute.
+//
+// Sibling tensors are found by tensor name, so nothing has to be plumbed
+// through llama.cpp. Values:
+//   0 (default) off
+//   1           from the gate prefetch the up projection (next op only)
+//   2           from the gate prefetch both up and down
+// ---------------------------------------------------------------------------
+#define BONSAI_MOE_MAX_LAYER 128
+
+static int g_moe_pf_mode = -1;                  // -1 = not read yet
+static const struct ggml_tensor * g_moe_gate[BONSAI_MOE_MAX_LAYER];
+static const struct ggml_tensor * g_moe_up  [BONSAI_MOE_MAX_LAYER];
+static const struct ggml_tensor * g_moe_down[BONSAI_MOE_MAX_LAYER];
+static atomic_long g_moe_pf_hints;
+
+static void moe_pf_report(void) {
+    const long n = atomic_load(&g_moe_pf_hints);
+    if (n > 0) {
+        fprintf(stderr, "BONSAI_MOE_PREFETCH: %ld expert-slice hints issued\n", n);
+    }
+}
+
+static int moe_pf_mode(void) {
+    if (g_moe_pf_mode < 0) {
+        const char * e = getenv("BONSAI_MOE_PREFETCH");
+        g_moe_pf_mode = e ? atoi(e) : 0;
+        if (g_moe_pf_mode > 0) {
+            atexit(moe_pf_report);   // so "does it actually fire" is observable
+        }
+    }
+    return g_moe_pf_mode;
+}
+
+// "blk.<N>.ffn_{gate,up,down}_exps.weight" -> kind 1/2/3, else 0
+static int moe_layer_kind(const char * name, int * layer) {
+    if (name == NULL) return 0;
+    const char * p = strstr(name, "blk.");
+    if (p == NULL) return 0;
+    int n = -1;
+    if (sscanf(p, "blk.%d.", &n) != 1) return 0;
+    if (n < 0 || n >= BONSAI_MOE_MAX_LAYER) return 0;
+    *layer = n;
+    if (strstr(p, "ffn_gate_exps") != NULL) return 1;
+    if (strstr(p, "ffn_up_exps")   != NULL) return 2;
+    if (strstr(p, "ffn_down_exps") != NULL) return 3;
+    return 0;
+}
+
+static void moe_pf_register(const struct ggml_tensor * t, int layer, int kind) {
+    switch (kind) {
+        case 1: g_moe_gate[layer] = t; break;
+        case 2: g_moe_up  [layer] = t; break;
+        case 3: g_moe_down[layer] = t; break;
+    }
+}
+
+static void moe_pf_hint(const struct ggml_tensor * t, const int64_t * counts, int64_t n_as) {
+    if (t == NULL || t->data == NULL) return;
+    const size_t slice = (size_t) t->nb[2];
+    if (slice == 0) return;
+    // posix_madvise rejects unaligned addresses (EINVAL), and an expert slice
+    // (460800 B) is not a multiple of the page size, so round the range out to
+    // whole pages. Without this the hint silently does nothing.
+    const uintptr_t pg = (uintptr_t) sysconf(_SC_PAGESIZE);
+    const uintptr_t mask = pg - 1;
+    for (int64_t a = 0; a < n_as; ++a) {
+        if (counts[a] == 0) continue;
+        const uintptr_t base = (uintptr_t) t->data + (uintptr_t) a * slice;
+        const uintptr_t lo = base & ~mask;
+        const uintptr_t hi = (base + slice + mask) & ~mask;
+        if (posix_madvise((void *) lo, (size_t) (hi - lo), POSIX_MADV_WILLNEED) == 0) {
+            atomic_fetch_add(&g_moe_pf_hints, 1);
+        }
+    }
+}
