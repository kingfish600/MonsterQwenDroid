+// ggml_compute_forward_moe_sum
+//
+// Sums the expert axis of [n_embd, n_expert_used, n_tokens] in a single pass.
+// build_moe_ffn used to emit a view per expert plus a chain of n_expert_used-1
+// adds: top-10 routing meant 10 views + 9 adds per layer, ~912 nodes per token,
+// about a third of the decode graph, each re-reading and re-writing a 2560-float
+// accumulator. Accumulation order is preserved so results stay bit-identical.
+static void ggml_compute_forward_moe_sum_f32(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    const ggml_tensor * src0 = dst->src[0];
+
+    GGML_ASSERT(src0->type  == GGML_TYPE_F32);
+    GGML_ASSERT(dst->type   == GGML_TYPE_F32);
+    GGML_ASSERT(src0->nb[0] == sizeof(float));
+    GGML_ASSERT(dst->nb[0]  == sizeof(float));
+    GGML_ASSERT(dst->ne[0]  == src0->ne[0]);
+    GGML_ASSERT(dst->ne[1]  == src0->ne[2]);
+    GGML_ASSERT(src0->ne[3] == 1);
+
+    const int64_t ne0   = dst->ne[0];
+    const int64_t ne1   = dst->ne[1];
+    const int64_t n_exp = src0->ne[1];
+
+    const char * src = (const char *) src0->data;
+    char       * out = (char       *) dst->data;
+
+    const int64_t total = ne0*ne1;
+    for (int64_t idx = params->ith; idx < total; idx += params->nth) {
+        const int64_t e = idx % ne0;
+        const int64_t t = idx / ne0;
+
+        const char * base = src + t*src0->nb[2] + e*sizeof(float);
+
+        float acc = 0.0f;
+        for (int64_t i = 0; i < n_exp; ++i) {
+            acc += *(const float *) (base + i*src0->nb[1]);
+        }
+        *(float *) (out + t*dst->nb[1] + e*sizeof(float)) = acc;
+    }
+}
+
+void ggml_compute_forward_moe_sum(
+        const ggml_compute_params * params,
+        ggml_tensor * dst) {
+
+    switch (dst->src[0]->type) {
+        case GGML_TYPE_F32:
+            {
+                ggml_compute_forward_moe_sum_f32(params, dst);
+            } break;
+        default:
+            {
+                GGML_ABORT("fatal error");
+            }
+    }
+}
+
